# Application
# Base path used when the web explorer is served from a sub-path (GitHub Pages).
# Optional. Example value: /arima-workshop-ccis/
WEB_BASE_PATH=/

# Data and storage
# Directory that holds the workshop CSV files. Optional. Default: ./data
ARIMA_DATA_DIR=./data

# Authentication and authorization
# None. The project has no login and no secrets.

# External integrations
# None. No component calls a network service at runtime.

# Observability
# None.
