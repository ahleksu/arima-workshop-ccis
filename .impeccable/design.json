  "narrative": {
    "northStar": "The Line Map",
    "overview": "The hour is a journey on two lines. The Lecture line has seven stops. The Hands-on line has five. They meet at one interchange at minute 20. Every screen is a station sign: white enamel on a pale platform, near-black ink, a thick colored line, round stops.",
    "keyCharacteristics": [
      "Four line colors with fixed meaning.",
      "One type family in two widths.",
      "Round stops on a thick line.",
      "Hairline rules, small radii, no shadows at rest.",
      "One authored motion."
    ],
    "rules": [
      {
        "name": "The One Line, One Meaning Rule",
        "body": "A line color names exactly one part of the hour.",
        "section": "colors"
      },
      {
        "name": "The Never Color Alone Rule",
        "body": "Every state that color carries also has a word or a shape.",
        "section": "colors"
      },
      {
        "name": "The Plain Number Rule",
        "body": "Numbers in running text use the plain zero of Barlow.",
        "section": "typography"
      },
      {
        "name": "The Flat Sign Rule",
        "body": "Panels have a 1px rule or a 2px colored border, never both a border and a soft shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use a line color for one meaning only.",
      "Do keep one idea per lecture screen.",
      "Do label illustrative data as synthetic.",
      "Do keep contrast at 4.5:1 or better for body text.",
      "Do keep all pages light."
    ],
    "donts": [
      "Do not add dark mode.",
      "Do not put a kicker above a heading.",
      "Do not use a colored side stripe thicker than 1px.",
      "Do not use a gradient, glass, or soft shadow on a sign.",
      "Do not stand glyphs or emoji in for icons."
    ]
  }
